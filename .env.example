# ---------- Telegram
# von @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# ohne @ – wird beim Start automatisch von Telegram geholt, darf auch leer bleiben
BOT_USERNAME=KryptoKumpelsBot
# öffentliche https-Adresse dieses Servers
WEBAPP_URL=https://deine-adresse.example.com
# deine Telegram-ID (für /status), z. B. über @userinfobot
ADMIN_ID=0
PORT=8000
DB_PATH=kumpels.db

# ---------- Werbung
# AdsGram Reward-Block-ID (nur Ziffern). Leer = Entwicklungsmodus: Diamanten ohne echtes Video!
ADSGRAM_BLOCK_ID=
# optional: AdsGram Interstitial-Block ("int-12345") – Vollbild-Werbung nach jedem 3. Pack
ADSGRAM_INTERSTITIAL_ID=
# optional: Monetag Zone-ID – springt ein, wenn AdsGram gerade keine Werbung hat
# RichAds (zweiter Anbieter nach AdsGram) – leer lassen zum Abschalten
RICHADS_PUB_ID=1028233
RICHADS_APP_ID=9592
MONETAG_ZONE_ID=
# true = nur von AdsGram per Reward-URL bestätigte Werbung zählt (empfohlen ab vielen Spielern)
ADS_VERIFY=false
# frei wählbares Passwort für die Reward-URL
ADSGRAM_SECRET=

# nur zum Testen: Diamanten ohne Werbeanbieter (im echten Betrieb immer false!)
DEV_MODE=false

# ---------- Gutschrift je 4-Stunden-Runde
# geschätzte Einnahmen pro 1.000 Werbungen in $ (nur für die Verlust-Warnung an ADMIN_ID)
ECPM_USD=1.5
# Notbremse: höchstens so viel $ pro Runde für alle zusammen (0 = keine Grenze)
MAX_PAYOUT_PER_ROUND=0
# Werbungen in 24 h, damit der Ertrag einer Runde gutgeschrieben wird
MIN_ADS_24H=1
# Mindestauszahlung in $ (wird in TRX umgerechnet; CryptoBot verlangt ca. 1 $ pro Überweisung)
MIN_PAYOUT=1.0

# ---------- CryptoBot
# off = nur gutschreiben · test = Testnetz · live = echtes Geld
PAYOUT_MODE=off
# aus @CryptoBot → Crypto Pay → Create App (Testnetz: @CryptoTestnetBot)
CRYPTOPAY_TOKEN=
PAYOUT_ASSET=TRX
# womit Spieler Aufladungen (Rechnung in $) bezahlen können
TOPUP_ASSETS=USDT,TRX

# ---------- Diamanten-Shop: Kaufen mit Guthaben, Aufladen per CryptoBot, Telegram Stars
# Erst einschalten, wenn rechtlich geprüft ist, ob Packs + Kauf + Krypto-Auszahlung als Glücksspiel gelten!
SHOP_ENABLED=false
